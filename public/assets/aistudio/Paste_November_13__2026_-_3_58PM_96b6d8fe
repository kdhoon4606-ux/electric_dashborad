<script>
  // Dynamic Date Selector Toggle
  const dropdownBtn = document.getElementById('dateDropdownBtn');
  const dropdownMenu = document.getElementById('dateDropdownMenu');
  const dropdownArrow = document.getElementById('dropdownArrow');
  const selectedDateText = document.getElementById('selectedDateText');
  const dateOptions = document.querySelectorAll('.date-option');

  if (dropdownBtn && dropdownMenu) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdownMenu.classList.toggle('hidden');
      dropdownMenu.classList.toggle('flex');
      dropdownArrow.classList.toggle('rotate-180');
    });

    document.addEventListener('click', () => {
      if (!dropdownMenu.classList.contains('hidden')) {
        dropdownMenu.classList.add('hidden');
        dropdownMenu.classList.remove('flex');
        dropdownArrow.classList.remove('rotate-180');
      }
    });

    dateOptions.forEach(opt => {
      opt.addEventListener('click', (e) => {
        const text = opt.querySelector('span').innerText;
        selectedDateText.innerText = text;
        dropdownMenu.classList.add('hidden');
        dropdownMenu.classList.remove('flex');
        dropdownArrow.classList.remove('rotate-180');
      });
    });
  }

  // Region Toggle Switcher
  const btnMainland = document.getElementById('regionMainland');
  const btnJeju = document.getElementById('regionJeju');
  const mainMetricVal = document.getElementById('mainMetricVal');

  if (btnMainland && btnJeju) {
    btnMainland.addEventListener('click', () => {
      btnMainland.className = 'px-4 py-2 rounded-lg font-label-md text-label-md transition-all bg-surface-container-lowest text-primary shadow-sm';
      btnJeju.className = 'px-4 py-2 rounded-lg font-label-md text-label-md transition-all text-secondary hover:text-on-surface';
      if (mainMetricVal) mainMetricVal.innerText = '142.8';
    });

    btnJeju.addEventListener('click', () => {
      btnJeju.className = 'px-4 py-2 rounded-lg font-label-md text-label-md transition-all bg-surface-container-lowest text-primary shadow-sm';
      btnMainland.className = 'px-4 py-2 rounded-lg font-label-md text-label-md transition-all text-secondary hover:text-on-surface';
      if (mainMetricVal) mainMetricVal.innerText = '149.3';
    });
  }

  // Interactive Chart Bars Tooltip Simulation
  const chartBars = document.querySelectorAll('.chart-bar');
  const chartDetailBanner = document.getElementById('chartDetailBanner');

  chartBars.forEach(bar => {
    bar.addEventListener('mouseenter', () => {
      const hour = bar.getAttribute('data-hour');
      const val = bar.getAttribute('data-val');
      const tag = bar.getAttribute('data-tag');
      let tagText = tag ? ` [${tag}]` : '';
      if (chartDetailBanner) {
        chartDetailBanner.innerHTML = `
          <span class="text-on-surface font-semibold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            ${hour}시 정산단가: <span class="text-primary font-bold">${val} 원/kWh</span>${tagText}
          </span>
          <span class="text-secondary">기준 시간: ${hour}:00 ~ ${hour}:59</span>
        `;
      }
    });

    bar.addEventListener('mouseleave', () => {
      if (chartDetailBanner) {
        chartDetailBanner.innerHTML = `
          <span class="text-secondary flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px] text-primary">touch_app</span> 막대 위로 커서를 이동해 시간별 가격을 탐색하세요
